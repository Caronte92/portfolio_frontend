{
  "name": "proyecto-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:local": "export REACT_APP_VERSION=local-local && eslint . && next dev",
    "build:start": "export REACT_APP_VERSION=local-local && next build && next start",
    "build": "export REACT_APP_VERSION=pro-$REACT_APP_COMMIT_ID && next build",
    "start:local:windows": "set REACT_APP_VERSION=local-local && eslint . && next dev",
    "build:start:windows": "set REACT_APP_VERSION=local-local && next build && next start",
    "build:windows": "set REACT_APP_VERSION=pro-$REACT_APP_COMMIT_ID && next build",
    "analyze": "ANALYZE=true next build",
    "analyze:windows": "set ANALYZE=true && next build",
    "start": "next start",
    "lint": "eslint .",
    "stylelint": "stylelint \"**/*.{ts,tsx,css}\"",
    "stylelint:fix": "stylelint \"**/*.{ts,tsx,css}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "extract:strings": "cp extractedTranslations/config.json babel.config.json && ./node_modules/.bin/babel -f babel.config.json 'src/**/*.{js,jsx,ts,tsx}' 'pages/**/*.{js,jsx,ts,tsx}' && rm babel.config.json",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.1.6",
    "next-intl": "4.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "styled-components": "6.3.9"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/styled-components": "5.1.36",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "babel-plugin-styled-components": "2.1.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "postcss-styled-syntax": "0.7.1",
    "prettier": "3.8.1",
    "stylelint": "17.3.0",
    "stylelint-config-recess-order": "7.6.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-styled-components": "0.1.1",
    "stylelint-order": "7.0.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "stylelint --fix",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
